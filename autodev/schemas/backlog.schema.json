{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autodev Backlog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "feature_title",
    "summary",
    "specification_path",
    "requirements",
    "tasks"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "minLength": 3
    },
    "feature_title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "specification_path": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "agent",
          "depends_on",
          "requirement_ids",
          "allowed_paths",
          "validation_commands",
          "acceptance_criteria",
          "shared_requirement_justifications",
          "dependency_change_reason",
          "validation_scope_justification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TASK-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "agent": {
            "type": "string",
            "enum": [
              "backend",
              "frontend",
              "database",
              "mapping",
              "qa",
              "packaging",
              "documentation"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TASK-[A-Z0-9-]+$"
            }
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
            }
          },
          "validation_commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shared_requirement_justifications": {
            "type": "array",
            "description": "Justifications des exigences volontairement partagées entre plusieurs tâches.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 3
                },
                "justification": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "required": [
                "requirement_id",
                "justification"
              ]
            }
          },
          "dependency_change_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 10,
            "description": "Justification d'un changement de dépendance, ou null si sans objet."
          },
          "validation_scope_justification": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 10
          }
        }
      }
    }
  }
}
